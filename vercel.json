{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd web && npm install",
  "buildCommand": "cd web && npm run build",
  "outputDirectory": "web/dist",
  "rewrites": [
    { "source": "/((?!api/|assets/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/copilot.py": {
      "maxDuration": 60,
      "excludeFiles": "{web/**,data/**,docs/**,planner/sunchaser/**,planner/tests/**,planner/fake/**,planner/out/**,planner/*.py,hardware/**,shared/grid_*.json}"
    }
  }
}
