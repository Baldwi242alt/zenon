{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'no install step: the copilot installs requirements.txt itself'",
  "buildCommand": "echo 'no build step yet: serving the shared data files'",
  "outputDirectory": "shared",
  "functions": {
    "api/copilot.py": {
      "maxDuration": 60,
      "excludeFiles": "{web/**,data/**,docs/**,planner/sunchaser/**,planner/tests/**,planner/fake/**,planner/out/**,planner/*.py,hardware/**,shared/grid_*.json}"
    }
  }
}
